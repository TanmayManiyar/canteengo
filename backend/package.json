{
  "name": "canteengo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CanteenGo REST API (Node.js + Express + MongoDB)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch-path=./src src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "mongodb": "^7.8.0",
    "serverless-http": "^4.0.0"
  }
}
